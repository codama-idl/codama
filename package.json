{
    "name": "codama-monorepo",
    "private": true,
    "scripts": {
        "build": "turbo run build --log-order grouped",
        "generate": "pnpm --filter @codama-internal/spec-generators generate",
        "lint": "oxlint && oxfmt --check",
        "lint:fix": "oxlint --fix && oxfmt",
        "test": "turbo run test --log-order grouped",
        "publish-packages": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.0",
        "@changesets/cli": "^3.0.1",
        "@solana-config/oxc": "^0.1.1",
        "@types/node": "^26",
        "agadoo": "^3.0.0",
        "browserslist-to-esbuild": "^2.1.1",
        "happy-dom": "^20.11.6",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "6.1.3",
        "tsup": "^8.5.1",
        "turbo": "^2.10.10",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "packageManager": "pnpm@10.15.1"
}
